{
	"name": "lectern",
	"version": "1.0.1",
	"description": "Obsidian plugin: office/code file preview with selectable pptx text and markdown-backed margin comments.",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"test": "vitest run"
	},
	"keywords": [],
	"author": "sqxirts",
	"license": "MIT",
	"devDependencies": {
		"@types/jsdom": "^30.0.0",
		"@types/node": "^22.10.2",
		"esbuild": "0.28.2",
		"jsdom": "^30.1.0",
		"obsidian": "^1.13.1",
		"playwright": "^1.63.0",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	},
	"dependencies": {
		"@jvmr/pptx-to-html": "^1.1.2",
		"docx-preview": "^0.4.0",
		"highlight.js": "^11.12.0",
		"jszip": "^3.10.2",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"esbuild@0.21.5": true
	}
}
